{
  "name": "chrome_demo",
  "version": "2.0",
  "description": "Build an Extension!",
  "permissions": [
    "tabs"
  ],
  "background": {
  "service_worker": "background.js"
   },
  "icons": {
    "16": "images/16.png",
    "32": "images/32.png",
    "64": "images/64.png",
    "128": "images/128.png"
  },
  "action": {
    "default_title": "网址收藏",
    "default_icon": "images/32.png"
  },
  "incognito": "split",
  "manifest_version": 3  // 注意这个必须写3
}
